# Copy to .env.local and fill in. Never commit .env files.
# All VITE_* values are bundled into public JS — do not put private API keys here.

# Production domain used for sitemap.xml / robots.txt
SITE_URL=https://inryth.com

# Optional: POST endpoint that receives contact-form leads as JSON.
# If empty, the form opens WhatsApp with the enquiry pre-filled.
VITE_LEAD_WEBHOOK_URL=

# Optional analytics IDs
VITE_GA_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
